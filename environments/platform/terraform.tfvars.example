aws_profile     = "default"
aws_region      = "ap-southeast-1"
resource_prefix = "aws-eks-infra"
vpc_cidr        = "10.0.0.0/16"

# Required. Your fork of this repository - Argo CD reconciles this repository
# through AWS CodeConnections, not the upstream one and not your working tree.
github_owner      = "your-github-username-or-org"
github_repository = "aws-eks-infra"

# Required. Your egress address as a /32. 0.0.0.0/0 is rejected by validation.
public_access_cidrs = ["203.0.113.10/32"]

# Required. Run the aws identitystore list-users command from README.md step 2.
argocd_admin_user_ids = [
  "IDENTITY_STORE_USER_ID",
]

# Required. Account-wide monthly cost budget alerts. The platform alone costs
# roughly USD 345/month (control plane, three t4g.large nodes, NAT, ALB).
budget_notification_emails = ["you@example.com"]
# monthly_budget_usd       = 400

# Optional. One Spot Graviton node with 4 GiB runs the whole platform.
# node_instance_types = ["t4g.medium", "m7g.medium", "m6g.medium"]
# node_capacity_type  = "SPOT"
# node_count          = 1
